# ===============================================
# Thinker DLP UI Template - Environment Variables
# ===============================================

# --- Google OAuth (REQUIRED for data upload) ---
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# --- NextAuth (REQUIRED) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=auth_secret

# --- Network Configuration (REQUIRED) ---
NEXT_PUBLIC_CHAIN_ID=14800
NEXT_PUBLIC_RPC_URL=https://rpc.moksha.vana.org

# --- Smart Contracts (REQUIRED) ---
# DataRegistry contract address (Moksha testnet default shown)
NEXT_PUBLIC_DATA_REGISTRY_ADDRESS=0x8C8788f98385F6ba1adD4234e551ABba0f82Cb7C

# DLP contract address (used for reward claims and DLP-specific operations)
NEXT_PUBLIC_DLP_CONTRACT_ADDRESS=0x3B826122C4EBc127cba30f1d69417743FE652B15

# --- PGE Configuration (REQUIRED for file encryption) ---
# PGE service URL for threshold decryption
NEXT_PUBLIC_PGE_URL=https://5d2f3c508220a6a0fdd07eb770eac06c319e758a-8000.dstack-pha-prod7.phala.network

# PGE Ethereum address (REQUIRED - must match runtime's PGE_ADDRESS)
# This is the address that receives file permissions
# Current PGE address (from sealed storage): 0xd77f86a23654d8c2563950435b4e2e091e49ef30
NEXT_PUBLIC_PGE_ADDRESS=0xd77f86a23654d8c2563950435b4e2e091e49ef30

# --- Vana Runtime (REQUIRED for task processing) ---
# Option A: Direct to runtime (local testing)
# NEXT_PUBLIC_DLP_RUNTIME_URL=http://localhost:8000

# Option B: Via orchestrator (production-like testing)
NEXT_PUBLIC_DLP_RUNTIME_URL=http://localhost:3000/api/v1/runtime/0xa2e19584bc2a4a293841128bb5b309914f67b865

NEXT_PUBLIC_TASK_ID=999

# --- Data Access V1 (NEW - REQUIRED) ---
# Dataset ID for this DLP
NEXT_PUBLIC_DATASET_ID=1

# DatasetRegistry contract address
NEXT_PUBLIC_DATASET_REGISTRY_ADDRESS=0xDad92767DD14308F1a72573fc47004A278Ac7479

# TODO-TEMP-REMOVE: DLP owner's private key for backend workaround
# This is ONLY acceptable for testnet demo - REMOVE before production
# Backend uses this to call DatasetRegistry.addPendingFile() on behalf of users
# Search for "TODO-TEMP-REMOVE" to find all related code to delete
DLP_OWNER_PRIVATE_KEY=
# --- Data Schema (REQUIRED for file uploads) ---
# Schema ID registered in Moksha for this DLP's data format
NEXT_PUBLIC_SCHEMA_ID=36
